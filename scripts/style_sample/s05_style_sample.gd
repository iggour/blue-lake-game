extends Node2D

## S05 style sample (photo-based art test). Standalone: does not touch main.gd or the chapter flow.
## Normal layer = processed museum photo + painted 《窗》; Blue Lake layer = #0078D7 + chalk + code.
## Art is generated by tools/art/s05_style_sample.py into assets/style_sample/.

const PlayerScript := preload("res://scripts/player.gd")
const CursorScript := preload("res://scripts/chalk_cursor.gd")
const RevealShader := preload("res://shaders/blue_lake_reveal.gdshader")

const ART := "res://assets/style_sample/"
const TEX_SCALE := 0.5                       # art is 2x the 1152x648 view
const WINDOW_CENTER := Vector2(590, 300)     # keep in sync with s05_layout.json
const WINDOW_SIZE := Vector2(150, 210)
const FLOOR_TOP := 485.0
const FLOOR_BOTTOM := 570.0
const REVEAL_TIME := 0.55
const REVEAL_MAX := 1500.0

enum WindowState { PAINTING, HANDLE, OPEN }

var window_state: int = WindowState.PAINTING
var window_observed := false
var blue_lake_active := false
var hover_window := false

var player: GrahamSteel
var chalk_cursor: Control
var reveal_material: ShaderMaterial
var normal_handle: Sprite2D
var normal_open: Sprite2D
var bl_handle: Sprite2D
var bl_open: Sprite2D
var hover_marker: Node2D
var dialogue_label: Label
var reveal_tween: Tween

func _ready() -> void:
	_setup_input_map()
	_add_sprite(self, "s05_normal.png")
	normal_handle = _add_sprite(self, "s05_normal_handle.png")
	normal_open = _add_sprite(self, "s05_normal_open.png")
	reveal_material = ShaderMaterial.new()
	reveal_material.shader = RevealShader
	reveal_material.set_shader_parameter("radius", 0.0)
	var bl := Node2D.new()
	bl.name = "BlueLakeLayer"
	add_child(bl)
	_add_sprite(bl, "s05_bluelake.png").material = reveal_material
	bl_handle = _add_sprite(bl, "s05_bluelake_handle.png")
	bl_handle.material = reveal_material
	bl_open = _add_sprite(bl, "s05_bluelake_open.png")
	bl_open.material = reveal_material
	hover_marker = Node2D.new()
	hover_marker.name = "HoverMarker"
	hover_marker.draw.connect(_draw_hover)
	add_child(hover_marker)
	_build_player()
	_build_ui()
	_refresh_overlays()
	_say("这间展厅的灯已经关了。墙上只剩那幅画还亮着。")

func _process(_delta: float) -> void:
	var mouse := get_viewport().get_mouse_position()
	var now_hover := blue_lake_active and window_state != WindowState.OPEN and _window_rect().has_point(mouse)
	if now_hover != hover_window:
		hover_window = now_hover
	hover_marker.queue_redraw()

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed("blue_lake"):
		toggle_blue_lake()
	elif event.is_action_pressed("interact"):
		observe()
	elif event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		chalk_click(event.position)

# ---- interaction (public so tests can drive it) -------------------------------------

func near_window() -> bool:
	return absf(player.position.x - WINDOW_CENTER.x) <= 130.0

func observe() -> void:
	if not near_window():
		_say("走近一点。")
		return
	window_observed = true
	match window_state:
		WindowState.PAINTING:
			_say("这是一幅画。\n……可它看起来太像一扇真正的窗。按 Space。")
		WindowState.HANDLE:
			_say("画框的边上多了一个黄铜把手。\n格雷汉：我刚才明明看过这里。")
		WindowState.OPEN:
			_say("画里的窗开着。后面是另一间展厅，有一座空展台。")

func toggle_blue_lake() -> void:
	blue_lake_active = not blue_lake_active
	chalk_cursor.set_active(blue_lake_active)
	reveal_material.set_shader_parameter("center", player.position)
	if reveal_tween:
		reveal_tween.kill()
	reveal_tween = create_tween()
	var target := REVEAL_MAX if blue_lake_active else 0.0
	reveal_tween.tween_method(_set_radius, _radius(), target, REVEAL_TIME).set_trans(Tween.TRANS_SINE)
	player.modulate = Color(0.85, 0.95, 1.25) if blue_lake_active else Color.WHITE
	if blue_lake_active:
		_say("Blue Lake：看。" if window_state == WindowState.PAINTING else "Blue Lake：……")
	else:
		_say("Blue Lake：……先收起来。")

func chalk_click(at: Vector2) -> void:
	if not blue_lake_active or not _window_rect().has_point(at):
		return
	match window_state:
		WindowState.PAINTING:
			window_state = WindowState.HANDLE
			_say("粉笔沿着画框划过。\nBlue Lake：把手一直在那里。只是你以前看不见。")
		WindowState.HANDLE:
			window_state = WindowState.OPEN
			_say("Blue Lake：你把一幅画……打开了。\n这不是出口。")
	_refresh_overlays()

func is_blue_lake_fully_shown() -> bool:
	return _radius() >= REVEAL_MAX - 1.0

# ---- helpers -------------------------------------------------------------------------

func _window_rect() -> Rect2:
	return Rect2(WINDOW_CENTER - WINDOW_SIZE * 0.5, WINDOW_SIZE)

func _radius() -> float:
	return float(reveal_material.get_shader_parameter("radius"))

func _set_radius(v: float) -> void:
	reveal_material.set_shader_parameter("radius", v)

func _refresh_overlays() -> void:
	normal_handle.visible = window_state == WindowState.HANDLE
	bl_handle.visible = window_state == WindowState.HANDLE
	normal_open.visible = window_state == WindowState.OPEN
	bl_open.visible = window_state == WindowState.OPEN

func _draw_hover() -> void:
	if not hover_window:
		return
	var pulse := 0.55 + 0.35 * sin(Time.get_ticks_msec() * 0.006)
	var r := _window_rect().grow(10.0)
	hover_marker.draw_rect(r, Color(1, 1, 1, pulse), false, 2.0)
	hover_marker.draw_rect(r.grow(5.0), Color(1, 1, 1, pulse * 0.35), false, 1.0)

func _add_sprite(parent: Node, file: String) -> Sprite2D:
	var s := Sprite2D.new()
	s.texture = load(ART + file)
	s.centered = false
	s.scale = Vector2(TEX_SCALE, TEX_SCALE)
	parent.add_child(s)
	return s

func _build_player() -> void:
	player = PlayerScript.new()
	player.ground_top = FLOOR_TOP
	player.ground_y = FLOOR_BOTTOM
	player.position = Vector2(300, 545)
	player.scale = Vector2(2.6, 2.6)       # placeholder body, scaled to the photographed room
	add_child(player)

func _build_ui() -> void:
	var layer := CanvasLayer.new()
	add_child(layer)
	dialogue_label = Label.new()
	dialogue_label.position = Vector2(176, 22)
	dialogue_label.size = Vector2(800, 70)
	dialogue_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	dialogue_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	dialogue_label.add_theme_font_size_override("font_size", 19)
	dialogue_label.add_theme_color_override("font_color", Color("#f2f4f6"))
	dialogue_label.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.85))
	dialogue_label.add_theme_constant_override("shadow_offset_x", 2)
	dialogue_label.add_theme_constant_override("shadow_offset_y", 2)
	layer.add_child(dialogue_label)
	var hint := Label.new()
	hint.text = "风格样张 · WASD 移动  E 观察  Space 蓝湖  左键 粉笔"
	hint.position = Vector2(16, 622)
	hint.add_theme_font_size_override("font_size", 13)
	hint.add_theme_color_override("font_color", Color(1, 1, 1, 0.55))
	layer.add_child(hint)
	chalk_cursor = CursorScript.new()
	layer.add_child(chalk_cursor)

func _say(text: String) -> void:
	dialogue_label.text = text

func _setup_input_map() -> void:
	var bindings := {
		"move_left": [KEY_A, KEY_LEFT], "move_right": [KEY_D, KEY_RIGHT],
		"move_up": [KEY_W, KEY_UP], "move_down": [KEY_S, KEY_DOWN],
		"interact": [KEY_E], "blue_lake": [KEY_SPACE]
	}
	for action in bindings:
		if not InputMap.has_action(action):
			InputMap.add_action(action)
		if InputMap.action_get_events(action).is_empty():
			for keycode in bindings[action]:
				var event := InputEventKey.new()
				event.physical_keycode = keycode
				InputMap.action_add_event(action, event)
